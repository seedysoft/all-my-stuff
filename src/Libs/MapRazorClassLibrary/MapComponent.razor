<HeadContent>
    <link href=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/lib/leaflet/dist/leaflet.css") rel="stylesheet" />
    <link href=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/lib/font-awesome/css/font-awesome.min.css") rel="stylesheet" />
    <link href=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/lib/mdidx/dist/material-design-icons.min.css") rel="stylesheet" />

    <script src="@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/lib/leaflet/dist/leaflet-global.js")"></script>
</HeadContent>

@if (!IsMapReady)
{
    <p>Loading map...</p>
}

<div id="@MapId" style="height:@Height; width:@Width;"></div>

