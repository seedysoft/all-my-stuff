<HeadContent>
    <link href=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/lib/leaflet/dist/leaflet.css") rel="stylesheet" />
    <link href=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/css/leaflet-loader.css") rel="stylesheet" />
    <link href=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/css/map-style-sheet.css") rel="stylesheet" />

    <script src=@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/lib/dompurify/dist/purify.min.js") type="text/javascript"></script>

    <script type="importmap">
    {
    "imports": {
        "leaflet": "@LeafletJavascriptFile",
        "leaflet-loader": "@($"{Core.Helpers.ContentHelper.ContentPath(typeof(MapComponent))}/js/leaflet-loader.js")"
    }
    }
    </script>
</HeadContent>

@if (!IsMapReady)
{
    <p>Loading map...</p>
}

<div id="@MapId" style="height:@Height; width:@Width;"></div>

@* <div>
    <label>Current zoom: @Zoom</label>
</div> *@
