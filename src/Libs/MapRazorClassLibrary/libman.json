{
  "$schema": "https://www.schemastore.org/libman.json",
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "leaflet@2.0.0-alpha.1",
      "provider": "cdnjs",
      "destination": "wwwroot/lib/leaflet/",
      "files": [
        "images/*.*",
        "leaflet.js",
        "leaflet.js.map",
        "leaflet.min.css",
        "leaflet-src.js",
        "leaflet-src.js.map"
      ]
    },
    {
      "library": "dompurify@3.4.12",
      "provider": "unpkg",
      "destination": "wwwroot/lib/DOMPurify",
      "files": [
        "dist/purify.min.js",
        "dist/purify.min.js.map"
      ]
    }
  ]
}