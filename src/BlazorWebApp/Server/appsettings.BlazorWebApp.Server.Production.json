{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "BlazorWebAppServerSettings": {
    "useOutbox": true,
    "usePvpc": true,
    "useTelegram": true,
    "useTuyaManager": false,
    "useUpdater": true,
    "useWebComparer": true
  },
  "Kestrel": {
    "EndPoints": {
      "Https": {
        "Certificate": {
          "Path": "/etc/ssl/certs/raspberrypi4.pem",
          "KeyPath": "/etc/ssl/private/raspberrypi4.key"
        },
        "Url": "https://raspberrypi4.seedy:5364"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
