{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "BlazorWebAppServerSettings": {
    "useOutbox": true,
    "usePvpc": true,
    "useTelegram": true,
    "useTuyaManager": false,
    "useUpdater": true,
    "useWebComparer": true
  },
  "Kestrel": {
    "EndPoints": {
      "Https": {
        "Certificate": {
          "Path": "/etc/letsencrypt/live/seedysoft.duckdns.org/fullchain.pem",
          "KeyPath": "/etc/letsencrypt/live/seedysoft.duckdns.org/privkey.pem"
        },
        "Url": "https://*:5364"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
