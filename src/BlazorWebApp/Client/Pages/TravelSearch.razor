@page "/travelsearch"

@attribute [StreamRendering(true)]

@using Seedysoft.Libs.MapRazorClassLibrary

@{
    Variant variant = Variant.Outlined;
}

<MudContainer MaxWidth="@MaxWidth.ExtraExtraLarge">

    <MudGrid Justify="@Justify.SpaceBetween">

        <MudItem xs="12" md="6">
            <MudAutocomplete @bind-Value="@TravelQueryModel.Orig"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AutoFocus="@(!System.Diagnostics.Debugger.IsAttached)"
                             Clearable
                             DebounceInterval="450"
                             Dense
                             For="@(() => TravelQueryModel.Orig)"
                             FullWidth
                             Label="Origin"
                             MaxItems="8"
                             MinCharacters="3"
                             Placeholder="Select an origin place"
                             RelativeWidth="MudBlazor.DropdownWidth.Adaptive"
                             Required
                             ResetValueOnEmptyText
                             SearchFunc="@FindPlacesAsync"
                             SelectOnActivation
                             SelectValueOnTab
                             ShowProgressIndicator
                             T="@Libs.Travel.ViewModels.Place"
                             ToStringFunc="@(x => x.Address)"
                             Variant="@variant" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudAutocomplete @bind-Value="@TravelQueryModel.Dest"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Clearable
                             DebounceInterval="450"
                             Dense
                             For="@(() => TravelQueryModel.Dest)"
                             FullWidth
                             Label="Destination"
                             MaxItems="8"
                             MinCharacters="3"
                             Placeholder="Select a destination place"
                             RelativeWidth="MudBlazor.DropdownWidth.Adaptive"
                             Required
                             ResetValueOnEmptyText
                             SearchFunc="@FindPlacesAsync"
                             SelectOnActivation
                             SelectValueOnTab
                             ShowProgressIndicator
                             T="@Libs.Travel.ViewModels.Place"
                             ToStringFunc="@(x => x.Address)"
                             Variant="@variant" />
        </MudItem>

        <MudItem xs="2">
            <MudButton ButtonType="@ButtonType.Button"
                       Class="flex-grow-all"
                       IconSize="@Size.Large"
                       OnClick="@OnSearchMudButtonClick"
                       Size="@Size.Large"
                       StartIcon="@Icons.Material.Filled.Search"
                       Variant="@variant">
                Search
            </MudButton>
        </MudItem>

        <MudItem xs="12">
            <MapComponent @ref="TravelMap"
                          Height="calc(50vh)"
                          Width="100%"
                          Center="@(new Libs.MapRazorClassLibrary.MapModels.Basic.LatLng(Libs.Travel.Constants.Earth.Burgos.Latitude, Libs.Travel.Constants.Earth.Burgos.Longitude))"
                          Zoom="18">
            </MapComponent>
            @{
                // OnMapClickAsyncEventCallback="OnMapClickAsyncEventCallback"
                // OnMapCreatedAsyncEventCallback="OnMapCreatedAsyncEventCallback"
                // OnMapMoveEndEventCallback="OnMapMoveEndEventCallback"
                // OnCircleMarkerClicEventCallback="OnCircleMarkerClicEventCallback"
                // TravelQueryModel="@TravelQueryModel"
                // GasStationsQueryModel = "@GasStationsQueryModel"
            }
        </MudItem>

    </MudGrid>

</MudContainer>
